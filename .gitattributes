* text=auto eol=lf

# Shell scripts and other files that MUST keep LF line endings, even on Windows.
# (Without this, scripts mounted into Linux containers fail with errors like
# `set: illegal option -` because the shell sees a trailing CR.)
*.sh         text eol=lf
*.bash       text eol=lf
Dockerfile*  text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf

# Site config mirror: preserve bytes exactly so a restore matches what the DB
# held. Several sites store setupScripts with CRLF endings, and the repo-wide
# `text=auto eol=lf` above would rewrite them — making the backup differ from
# the live value it exists to reproduce.
sites/_configs/*.setup.js -text
