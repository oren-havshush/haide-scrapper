# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
.env.worker

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# WXT extension build output
extension/.output/
extension/.wxt/

# Local Claude Code scrap onboarding token (do NOT commit)
.claude/scrap-token

# /addsite skill scratch directory — per-onboarding artifacts written by the skill
.scratch/

# /addsite2 per-site scratch helpers written at the repo root during onboarding
# (config-writer scripts and temp JSON/text payloads — never meant to be committed)
/write-*-config.js
/tmp-*.json
/tmp-*.txt

# Per-site scratch sub-buckets under sites/<name>/.scratch/ — see docs/sites-layout.md
sites/**/.scratch/

# Oversize artifacts that live under sites/<name>/ but are not worth committing
sites/**/*.png
sites/**/*.bin
sites/**/raw-*.json
sites/**/*-raw*.json
sites/**/*.pma

# Windows
Thumbs.db
*.log

# npm lockfile — this project installs with pnpm (pnpm-lock.yaml is the tracked
# one, and the Dockerfile runs `pnpm install --frozen-lockfile`). A
# package-lock.json only ever appears when someone runs `npm install` by
# mistake, and committing it would leave two lockfiles disagreeing.
package-lock.json

# Batch input data under "CSV files/" — per-onboarding link lists and
# company/URL exports, scratch by nature. city.csv is the exception: it is the
# canonical city vocabulary the location gate validates against
# (scripts/lib/city-csv.ts), so it stays tracked. Any future canonical list
# needs its own negation here, which is deliberate — data files should be
# opt-in, not swept in.
CSV files/*.csv
!CSV files/city.csv
