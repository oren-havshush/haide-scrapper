generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SiteStatus {
  ANALYZING
  REVIEW
  ACTIVE
  FAILED
  SKIPPED
}

enum ScrapeRunStatus {
  IN_PROGRESS
  COMPLETED
  PARTIAL
  FAILED
}

enum AnalysisMethod {
  PATTERN_MATCH
  CRAWL_CLASSIFY
  NETWORK_INTERCEPT
  AI_REFINE
}

enum JobStatus {
  PENDING
  VALID
  INVALID
  NEEDS_REVIEW
}

enum WorkerJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum WorkerJobType {
  ANALYSIS
  SCRAPE
  POLICY_REVIEW
}

enum ScrapingPolicyStatus {
  NOT_CHECKED
  POLICY_NOT_FOUND
  NO_EXPLICIT_RESTRICTION
  RESTRICTED
  REQUIRES_WRITTEN_PERMISSION
  UNCLEAR_NEEDS_REVIEW
  CHECK_FAILED
}

model Site {
  id              String      @id @default(cuid())
  siteUrl         String      @unique
  companyName     String?
  status          SiteStatus  @default(ANALYZING)
  confidenceScore Float?
  configLocked    Boolean     @default(false)
  fieldMappings   Json?
  pageFlow        Json?
  adminNote       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  analyzingAt     DateTime?
  reviewAt        DateTime?
  activeAt        DateTime?
  failedAt        DateTime?
  skippedAt       DateTime?

  jobs                 Job[]
  scrapeRuns           ScrapeRun[]
  analysisResults      AnalysisResult[]
  workerJobs           WorkerJob[]
  jobLocationOverrides JobLocationOverride[]
  policyReviews        ScrapingPolicyReview[]

  scrapingPolicyStatus    ScrapingPolicyStatus @default(NOT_CHECKED)
  scrapingPolicyCheckedAt DateTime?

  /// --- Company profile ---------------------------------------------------
  /// Captured ONCE at onboarding by scripts/company-profile.ts and never
  /// refreshed. Every field is nullable and additive: the public jobs site
  /// reads this database directly, so nothing here may become NOT NULL, change
  /// type, or be renamed. Absence is ALWAYS expressed as NULL, never as "".

  /// Corporate homepage (origin only, no path). Derived from siteUrl by
  /// stripping the careers subdomain, then header/footer link, then og:url.
  companyHomepageUrl String?

  /// Plain-text "about the company" copy in the site's own language (usually
  /// he-IL). TEXT ONLY — never HTML; the reader may render it unescaped.
  companyAbout String?

  /// Public path of the self-hosted logo, e.g. "/logos/<siteId>.png".
  /// PATH ONLY, never absolute, so the reader prefixes its own origin.
  /// NULL means no logo — render nothing, not a placeholder, not a favicon.
  companyLogoPath String?

  /// Where the logo bytes were downloaded from. Retained ONLY so the file can
  /// be re-fetched if the `logos` volume is ever lost. Never displayed.
  companyLogoSourceUrl String?

  /// Full HQ address line as published by the company.
  companyHqAddress String?

  /// The HQ city, VERBATIM from "CSV files/city.csv". NULL when no city on
  /// that list matched — never store an off-list value (see the job-location
  /// gate, which enforces the same discipline for Job.location).
  companyHqCity String?

  /// Who authored companyHqCity, and on what evidence. NULL means the capture
  /// extracted it from a real address, or nobody has set one.
  ///
  /// Load-bearing, not documentation: companyHqCity is written both by the
  /// capture and by a human who looked the company up when the capture found
  /// nothing. A re-capture of such a site finds no city again — that is why one
  /// was supplied — and would write NULL straight over the human's answer.
  /// Authority has to be recorded because it cannot be inferred from the value.
  ///
  /// "operator" | "operator:none" (a human looked; the company publishes no HQ
  /// city) | "skill <evidence-url>" | NULL. TEXT, not an enum, for the reason
  /// companyProfileStatus is TEXT.
  companyHqCitySource String?

  /// Lifecycle marker. TEXT, not an enum, so an unrecognised value can never
  /// throw in a consumer's Prisma client and so values stay removable.
  /// NULL (never attempted) | "COMPLETE" | "PARTIAL" | "FAILED".
  companyProfileStatus String?

  /// When the one-shot capture ran. NULL <=> never attempted. This is the
  /// field that separates "not attempted" from "attempted, found nothing".
  companyProfileAt DateTime?
}

model Job {
  id               String    @id @default(cuid())
  title            String
  description      String?
  requirements     String?
  /// Primary location — kept as the single display value so existing readers
  /// (including the public site, which queries this database directly) keep
  /// working unchanged. Always equal to locations[0] when locations is set.
  location         String
  /// Every location the job names, canonicalised against "CSV files/city.csv".
  /// ~15% of jobs list more than one ("חולון ובת-ים, ת\"א, מודיעין"), which a
  /// single string cannot represent. Empty only for jobs that state no location.
  locations        String[] @default([])
  department       String?
  externalJobId    String?
  publishDate      String?
  deadline         String?
  ageBucket        String?
  applicationInfo  String?
  detailUrl        String?
  rawData          Json
  validationStatus String?
  siteId           String
  site             Site      @relation(fields: [siteId], references: [id])
  scrapeRunId      String
  scrapeRun        ScrapeRun @relation(fields: [scrapeRunId], references: [id])
  createdAt        DateTime  @default(now())

  @@index([siteId])
  @@index([scrapeRunId])
  @@index([ageBucket])
}

model ScrapeRun {
  id              String          @id @default(cuid())
  siteId          String
  site            Site            @relation(fields: [siteId], references: [id])
  status          ScrapeRunStatus @default(IN_PROGRESS)
  jobCount        Int             @default(0)
  totalJobs       Int?
  validJobs       Int?
  invalidJobs     Int?
  error           String?
  failureCategory String?
  warnings        Json?
  createdAt       DateTime        @default(now())
  completedAt     DateTime?

  jobs Job[]

  @@index([siteId])
}

// Stores per-job manual location overrides keyed by (siteId, jobKey).
// jobKey = externalJobId ?? detailUrl — stable across re-scrapes.
// The worker re-applies these after every scrape run so manual edits persist.
model JobLocationOverride {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  jobKey    String
  /// Primary override value (mirrors Job.location).
  location  String
  /// Full override list. Without this a manual multi-location edit would be
  /// silently collapsed back to one value on the next scrape.
  locations String[] @default([])
  /// The job's title when the override was set. Nullable: rows written before
  /// this column stay NULL, which is true of them.
  ///
  /// jobKey is `externalJobId ?? detailUrl`, and on a site with no id mapping
  /// that is a synthesised `h-<hash>` whose stability depends on the config
  /// that seeds it — halilit re-keyed 6 of 7 jobs across one config change. An
  /// override that stops matching is otherwise a row reading "site X, key
  /// h-1p1cu0x, חיפה", which nobody can re-apply or delete with confidence.
  jobTitle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, jobKey])
  @@index([siteId])
}

model AnalysisResult {
  id                String         @id @default(cuid())
  siteId            String
  site              Site           @relation(fields: [siteId], references: [id])
  method            AnalysisMethod
  fieldMappings     Json
  confidenceScores  Json
  overallConfidence Float
  apiEndpoint       String?
  createdAt         DateTime       @default(now())

  @@index([siteId])
}

model WorkerJob {
  id          String          @id @default(cuid())
  siteId      String
  site        Site            @relation(fields: [siteId], references: [id])
  type        WorkerJobType
  status      WorkerJobStatus @default(PENDING)
  payload     Json?
  result      Json?
  error       String?
  attempts    Int             @default(0)
  createdAt   DateTime        @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  /// The ScrapeRun this job owns, for SCRAPE jobs. NULL on every other type,
  /// and NULL when the run it named no longer exists.
  ///
  /// DELIBERATELY NOT A FOREIGN KEY. `clearSiteJobs` (siteService.ts) deletes a
  /// site's ScrapeRuns and leaves its WorkerJobs standing, so a payload on the
  /// box can already name a run that is gone. Every FK action is worse than
  /// none here: RESTRICT would make `clearSiteJobs` throw, CASCADE would delete
  /// worker history to tidy up a run, and SET NULL would erase the link the
  /// reaper needs. The reaper joins and finds nothing, which is correct.
  ///
  /// The backfill therefore wrote this only WHERE the run still EXISTS — a dead
  /// id would assert that a run is there when it is not, and a wrong value is
  /// worse than a missing one.
  scrapeRunId String?

  @@index([siteId])
  @@index([status, type])
  /// The reaper's claim query: oldest active jobs first.
  @@index([status, createdAt])
  @@index([scrapeRunId])
}

/// One sweep — a night's scrape pass or policy pass.
///
/// `kind`, `status` and `trigger` are TEXT rather than enums, following
/// `Site.companyProfileStatus`: an unrecognised value can never throw in a
/// consumer's Prisma client, and values stay removable without a migration.
///
///   kind    "SCRAPE" | "POLICY"
///   status  "RUNNING" | "COMPLETED" | "HALTED" | "FAILED"
///   trigger "timer" | "manual" | "dry-run"
model ScrapeSweep {
  id         String    @id @default(cuid())
  kind       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("RUNNING")
  trigger    String

  selectedCount     Int @default(0)
  ok                Int @default(0)
  failed            Int @default(0)
  silentDrift       Int @default(0)
  skippedConflict   Int @default(0)
  wouldHaveDemoted  Int @default(0)
  wouldHavePromoted Int @default(0)
  listingsProtected Int @default(0)
  /// Multi-page sites that declined to publish a partial set, and sites that
  /// returned nothing and had nothing. Both used to be counted as silentDrift,
  /// which is a different thing: drift is a site that changed under us.
  ///
  /// closeSweep spreads the whole SweepCounters object into this row, so every
  /// counter MUST have a column here — adding one without a migration throws
  /// "Unknown argument" at the end of the night, after every site has been
  /// scraped, and leaves the sweep row RUNNING with no report.
  /// scripts/sweepCountersSchema.test.ts pins the two together.
  listingRefusals   Int @default(0)
  noJobs            Int @default(0)

  haltedAt   DateTime?
  haltReason String?
  /// The rendered report. Held here so the dashboard needs no filesystem
  /// access — the `web` container cannot see the worker's volumes.
  logText String?

  items ScrapeSweepItem[]

  @@index([kind, startedAt])
  @@index([status])
}

/// One site's result within a sweep. Per-site rows rather than a blob, because
/// "which sites have been red three nights running" has to be a query.
///
/// `siteId` is NOT a foreign key, for the same reason as WorkerJob.scrapeRunId:
/// `deleteSite` would either fail or take the sweep history with it, and a
/// night's log should outlive the site it described.
model ScrapeSweepItem {
  id      String      @id @default(cuid())
  sweepId String
  sweep   ScrapeSweep @relation(fields: [sweepId], references: [id], onDelete: Cascade)
  siteId  String
  /// "scrape" | "policy" — a site can appear once per phase per sweep.
  phase           String
  scrapeRunId     String?
  outcome         String
  failureCategory String?
  jobsBefore      Int       @default(0)
  jobsAfter       Int       @default(0)
  newestJobAt     DateTime?
  siteStatus      String
  /// What the scheduled gate withheld. NULL when it withheld nothing.
  wouldDemoteTo  String?
  wouldPromoteTo String?
  /// Policy phase only: scrapingPolicyStatus before and after tonight's check,
  /// which together make "newly RESTRICTED" answerable from the row alone.
  /// NULL on scrape items. TEXT rather than the enum, like the rest of this
  /// table, so the sweep log never blocks an enum change.
  policyStatusBefore String?
  policyStatusAfter  String?
  /// Scrape phase: listings the run extracted and was prepared to write
  /// (ScrapeRun.validJobs). Equal to jobsAfter when the write committed; when
  /// the undersize guard (outcome "suspicious_drop") or the oversize cap refused
  /// it, this is the refused count and jobsAfter is what was kept. NULL when the
  /// run produced no count.
  scrapedCount   Int?
  /// Scrape phase: the run's own ScrapeRun.warnings ("type: detail" strings),
  /// copied so the item is readable without the run. NULL when it had none.
  warnings       Json?
  startedAt      DateTime?
  finishedAt     DateTime?

  @@unique([sweepId, siteId, phase])
  @@index([siteId])
  @@index([sweepId])
}

model ScrapingPolicyReview {
  id                        String               @id @default(cuid())
  siteId                    String
  site                      Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  status                    ScrapingPolicyStatus
  isScrapingRestricted      Boolean?
  requiresWrittenPermission Boolean?
  confidence                Int?
  language                  String?
  shortReason               String?
  matchedTerms              String[]
  evidenceSnippets          Json?
  reviewedUrls              String[]
  discoveredUrls            String[]
  reviewedDocTypes          String[]
  cleanedText               String?
  llmResultJson             Json?
  pagesChecked              Int                  @default(0)
  searchFallbackUsed        Boolean              @default(false)
  reviewSource              String?
  robotsChecked             Boolean              @default(false)
  robotsDisallowsAll        Boolean?
  robotsRelevantRules       String[]
  errorMessage              String?
  nextReviewAt              DateTime?
  model                     String?
  createdAt                 DateTime             @default(now())

  @@index([siteId])
  @@index([status])
}
