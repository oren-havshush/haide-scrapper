DATABASE_URL="postgresql://user:password@localhost:5432/scrapnew?schema=public"
API_TOKEN="your-api-token-here"
# Per-operator tokens, accepted alongside API_TOKEN: "label:secret,label:secret".
# Each operator's .claude/scrap-token holds only their secret. Labels are never logged.
API_TOKENS=""
NEXT_PUBLIC_API_TOKEN="your-api-token"
